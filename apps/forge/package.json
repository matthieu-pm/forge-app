{
  "name": "@forge/app",
  "productName": "Forge",
  "version": "0.1.0",
  "description": "Forge — one shared product across the web and macOS.",
  "main": ".electron-build/main.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "desktop:host": "wait-on http://localhost:3000 && electron-forge start",
    "email:dev": "email dev --dir src/emails --port 3001",
    "build": "vite build && bun scripts/verify-workflow-build.ts",
    "desktop:build": "bun run desktop:build:main && bun run desktop:build:preload",
    "desktop:build:main": "vite build --config electron.vite.config.ts",
    "desktop:build:preload": "vite build --config electron.preload.vite.config.ts",
    "desktop:start": "electron-forge start",
    "desktop:package": "bun run desktop:validate && electron-forge package --platform darwin",
    "desktop:make": "bun run desktop:validate && electron-forge make --platform darwin",
    "desktop:release:prepare": "bun scripts/desktop-release/prepare-candidate.ts",
    "desktop:release:upload": "bun scripts/desktop-release/upload-candidate.ts",
    "desktop:release:promote": "bun scripts/desktop-release/change-release-state.ts promote",
    "desktop:release:pause": "bun scripts/desktop-release/change-release-state.ts pause",
    "desktop:validate": "bun scripts/validate-desktop-environment.ts",
    "preview": "vite preview",
    "test": "vitest run && bun run test:workflow",
    "test:workflow": "vitest run --config vitest.workflow.config.ts",
    "agent:retention": "bun scripts/sweep-agent-retention.ts",
    "product:retention": "bun scripts/sweep-product-retention.ts",
    "workflow:health": "bun scripts/check-workflow-health.ts",
    "test:desktop": "bun run desktop:build && playwright test --config playwright.desktop.config.ts",
    "test:desktop:packaged": "bun scripts/desktop-release/smoke-packaged.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/api-key": "1.6.26",
    "@better-auth/core": "1.6.26",
    "@better-auth/drizzle-adapter": "1.6.26",
    "@better-auth/electron": "1.6.26",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@neondatabase/serverless": "^1.1.0",
    "@orpc/contract": "1.14.14",
    "@orpc/openapi": "1.14.14",
    "@orpc/server": "1.14.14",
    "@orpc/zod": "1.14.14",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "^1.168.26",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "conf": "15.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "emojibase-data": "17.0.0",
    "framer-motion": "^13.0.0",
    "input-otp": "^1.4.2",
    "jose": "6.2.8",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260610-beta",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "rehype-sanitize": "^6.0.0",
    "resend": "^6.18.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "undici": "8.10.0",
    "vaul": "^1.1.2",
    "workflow": "4.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@aws-sdk/client-s3": "3.1104.0",
    "@playwright/test": "1.62.1",
    "@react-email/render": "2.1.0",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@workflow/vitest": "4.0.16",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "electron": "43.3.0",
    "eslint": "^10.8.0",
    "execa": "10.0.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-email": "^6.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "9.1.0",
    "web-vitals": "^6.1.0"
  }
}
