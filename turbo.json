{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "@forge/app#build": {
      "env": ["DATABASE_URL", "BETTER_AUTH_URL", "BETTER_AUTH_SECRET"],
      "outputs": [".output/**"]
    },
    "@forge/agent-runtime#build": {
      "outputs": [".output/**", ".eve/builds/**"]
    },
    "test": {
      "tags": ["ci"],
      "outputs": []
    },
    "typecheck": {
      "tags": ["ci"],
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "tags": ["ci"],
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "desktop:host": {
      "cache": false,
      "persistent": true
    },
    "desktop:build": {
      "dependsOn": ["^build"],
      "outputs": [".electron-build/**"]
    },
    "desktop:start": {
      "cache": false,
      "persistent": true
    },
    "desktop:package": {
      "cache": false,
      "outputs": ["out/**"],
      "passThroughEnv": ["APPLE_*", "R2_*", "CI_COMMIT_TAG", "CI_JOB_URL"]
    },
    "desktop:make": {
      "cache": false,
      "outputs": ["out/**"],
      "passThroughEnv": ["APPLE_*", "R2_*", "CI_COMMIT_TAG", "CI_JOB_URL"]
    },
    "desktop:release:prepare": {
      "cache": false,
      "outputs": ["release-candidate/**"],
      "passThroughEnv": ["APPLE_*", "R2_*", "CI_COMMIT_TAG", "CI_JOB_URL"]
    },
    "desktop:validate": {
      "cache": false,
      "passThroughEnv": ["APPLE_*", "R2_*", "CI_COMMIT_TAG", "CI_JOB_URL"]
    },
    "desktop:release:upload": {
      "cache": false,
      "passThroughEnv": ["APPLE_*", "R2_*", "CI_COMMIT_TAG", "CI_JOB_URL"]
    },
    "desktop:release:promote": {
      "cache": false,
      "passThroughEnv": ["APPLE_*", "R2_*", "CI_COMMIT_TAG", "CI_JOB_URL"]
    },
    "desktop:release:pause": {
      "cache": false,
      "passThroughEnv": ["APPLE_*", "R2_*", "CI_COMMIT_TAG", "CI_JOB_URL"]
    },
    "test:desktop": {
      "cache": false,
      "outputs": ["test-results/**"]
    },
    "email:dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "agent:retention": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "BLOB_READ_WRITE_TOKEN", "R2_*"]
    },
    "product:retention": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "BLOB_READ_WRITE_TOKEN", "R2_*"]
    },
    "workflow:health": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "BLOB_READ_WRITE_TOKEN", "R2_*"]
    },
    "eval": {
      "cache": false
    },
    "calls:sync": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_URL",
        "OPENAI_API_KEY",
        "FORGE_MODEL_CREDENTIAL_KEK",
        "FORGE_*_CLIENT_ID",
        "FORGE_*_CLIENT_SECRET",
        "FORGE_CALLS_SUMMARY_MODEL"
      ],
      "passThroughEnv": ["FORGE_*"]
    }
  },
  "globalPassThroughEnv": ["CI", "NODE_ENV", "VERCEL*", "FORGE_*"]
}
