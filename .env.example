DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
# Service configuration: development (default locally), staging or production.
# Set FORGE_ENVIRONMENT explicitly in each deployment/job/release environment.
# See docs/operations/service-configuration.md and bun run config:check app.
# Direct Neon connection for migrations (optional for other Postgres providers).
DATABASE_URL_UNPOOLED=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Server-only Resend credentials. Use onboarding@resend.dev for local testing,
# then replace the sender with an address on your verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Forge <onboarding@resend.dev>
PUBLIC_API_ENABLED=true
# Optional Forge-managed OpenAI billing source. The key stays server-side.
OPENAI_API_KEY=
# Optional comma-separated catalog for the managed source.
FORGE_MANAGED_OPENAI_MODELS=gpt-6-astra,gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
EVE_AGENT_RUNTIME_URL=
FORGE_AGENT_CHANNEL_SECRET=replace-with-a-long-random-secret
FORGE_AGENT_CAPABILITY_SECRET=replace-with-a-long-random-secret
FORGE_AGENT_LOCAL_INGEST_SECRET=replace-with-a-long-random-secret
FORGE_AGENT_MODEL_ACCESS_SECRET=replace-with-a-long-random-secret
FORGE_MODEL_CREDENTIAL_KEK=replace-with-a-base64-encoded-32-byte-key
FORGE_FEATURE_AGENT_UI=true
FORGE_FEATURE_AGENT_EVE_RUNTIME=true
FORGE_FEATURE_AGENT_CODE_MODE=true
FORGE_FEATURE_AGENT_PROGRAMMATIC_TOOLS=true
FORGE_FEATURE_AGENT_WRITE_TOOLS=true
FORGE_FEATURE_AGENT_SKILLS=false
FORGE_FEATURE_AGENT_MODEL_CONNECTIONS=true
FORGE_FEATURE_AGENT_AUTO_OPENAI=true
FORGE_FEATURE_AGENT_CODEX_LOCAL=true
FORGE_FEATURE_AGENT_CLAUDE_LOCAL_BETA=false
FORGE_FEATURE_AGENT_PROVIDER_OPENAI=true
FORGE_FEATURE_AGENT_PROVIDER_ANTHROPIC=true
FORGE_FEATURE_AGENT_PROVIDER_GOOGLE=true
FORGE_FEATURE_AGENT_PROVIDER_MINIMAX=true
FORGE_FEATURE_AGENT_PROVIDER_MISTRAL=true
FORGE_FEATURE_AGENT_PROVIDER_XAI=true
FORGE_FEATURE_AGENT_PROVIDER_DEEPSEEK=true
FORGE_FEATURE_AGENT_PROVIDER_KIMI=true
FORGE_FEATURE_AGENT_PROVIDER_CUSTOM_OPENAI=true
FORGE_FEATURE_AGENT_PROVIDER_CUSTOM_ANTHROPIC=true
# Invitation workflows require both the global flag and an explicit workspace
# allowlist entry during rollout.
FORGE_FEATURE_INVITATION_WORKFLOW=false
FORGE_INVITATION_WORKFLOW_WORKSPACE_ALLOWLIST=
FORGE_AGENT_RUN_WALL_CLOCK_MS=900000
FORGE_AGENT_MAX_INPUT_TOKENS=200000
FORGE_AGENT_MAX_OUTPUT_TOKENS=50000
FORGE_AGENT_MAX_ATTACHMENT_BYTES=5242880
FORGE_AGENT_MAX_TURN_ATTACHMENT_BYTES=20971520
FORGE_AGENT_ATTACHMENT_RETENTION_HOURS=24
FORGE_AGENT_MAX_ARTIFACT_BYTES=5242880
FORGE_AGENT_ARTIFACT_RETENTION_DAYS=30
# Store generated artifacts outside the public web root on a persistent volume.
FORGE_AGENT_ARTIFACT_DIRECTORY=.forge/agent-artifacts
# Optional dedicated signing secret; falls back to FORGE_AGENT_CAPABILITY_SECRET.
FORGE_AGENT_ARTIFACT_SECRET=
# Optional monthly spend caps in millionths of a US dollar. Empty means no cap.
FORGE_AGENT_USER_MONTHLY_BUDGET_MICROS=
FORGE_AGENT_WORKSPACE_MONTHLY_BUDGET_MICROS=
# Optional comma-separated admin allowlists.
FORGE_AGENT_ALLOWED_PROVIDERS=
FORGE_AGENT_ALLOWED_CAPABILITIES=
FORGE_DESKTOP_APP_ORIGIN=https://app.example.com
FORGE_DESKTOP_UPDATE_BASE_URL=https://app.example.com/api/desktop/updates
FORGE_DESKTOP_DOWNLOAD_ORIGIN=https://downloads.example.com
# Enables server release configuration checks and desktop object retention.
FORGE_DESKTOP_RELEASE_ENABLED=false
# Server-only bearer credential used exclusively by protected desktop release CI.
FORGE_DESKTOP_RELEASE_API_SECRET=replace-with-a-long-random-secret

# Native meeting transcript OAuth apps. Register /api/calls/oauth/callback on BETTER_AUTH_URL.
# Credentials remain server-side and require FORGE_MODEL_CREDENTIAL_KEK above.
# Enable only the selected providers after their release gates pass.
FORGE_CALLS_ENABLED=false
FORGE_CALLS_PROVIDERS=
FORGE_GOOGLE_MEET_CLIENT_ID=
FORGE_GOOGLE_MEET_CLIENT_SECRET=
FORGE_MICROSOFT_TEAMS_CLIENT_ID=
FORGE_MICROSOFT_TEAMS_CLIENT_SECRET=
FORGE_ZOOM_CLIENT_ID=
FORGE_ZOOM_CLIENT_SECRET=
# Optional summary model override. Uses OPENAI_API_KEY; no recordings are uploaded.
FORGE_CALLS_SUMMARY_MODEL=
# Run bun run calls:sync in your job scheduler every five minutes.

# Polar billing: server-only. Keep disabled until catalog, reconciliation and release gates pass.
FORGE_BILLING_ENABLED=false
# Keep off until the full lifecycle, provider reconciliation and billing gate pass.
FORGE_BILLING_WEBHOOKS_ENABLED=false
# Explicit sandbox/production selection is required when billing is enabled.
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Approved monthly seat-based products: Starter 10 EUR/USD, Plus 16 EUR/USD.
# Each currency has its own exact catalog product; Enterprise uses custom pricing.
# EUR/USD may share a plan product when it has native prices in both currencies.
POLAR_STARTER_EUR_PRODUCT_ID=
POLAR_STARTER_USD_PRODUCT_ID=
POLAR_PLUS_EUR_PRODUCT_ID=
POLAR_PLUS_USD_PRODUCT_ID=
