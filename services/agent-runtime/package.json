{
  "name": "@forge/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-with-root-env.mjs eve dev --no-ui",
    "build": "node scripts/run-with-root-env.mjs eve build",
    "start": "node scripts/run-with-root-env.mjs eve start",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/apply-diagnostic-policy.mjs && vitest run",
    "eval": "node scripts/run-evals.mjs",
    "eval:live": "node scripts/run-with-root-env.mjs eve eval --strict"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.33",
    "@ai-sdk/openai": "4.0.33",
    "ai": "7.0.55",
    "eve": "0.31.0",
    "jose": "6.2.8",
    "zod": "4.4.3",
    "@forge/environment": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "microsandbox": "^0.6.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
