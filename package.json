{
  "name": "forge-desktop",
  "productName": "Forge",
  "version": "0.1.0",
  "description": "Forge — one shared product across the web and macOS.",
  "main": ".electron-build/main.js",
  "packageManager": "bun@1.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:web": "vite dev --port 3000",
    "dev:desktop": "concurrently --kill-others --success first \"bun run dev:web\" \"wait-on http://localhost:3000 && electron-forge start\"",
    "build": "vite build",
    "desktop:build": "bun run desktop:build:main && bun run desktop:build:preload",
    "desktop:build:main": "vite build --config electron.vite.config.ts",
    "desktop:build:preload": "vite build --config electron.preload.vite.config.ts",
    "desktop:start": "electron-forge start",
    "desktop:package": "bun run desktop:validate && electron-forge package --platform darwin",
    "desktop:make": "bun run desktop:validate && electron-forge make --platform darwin",
    "desktop:validate": "bun scripts/validate-desktop-environment.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:desktop": "bun run desktop:build && playwright test --config playwright.desktop.config.ts",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@better-auth/electron": "1.6.23",
    "@fontsource-variable/geist": "^5.2.9",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@neondatabase/serverless": "^1.0.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-devtools": "^0.10.0",
    "@tanstack/react-router": "^1.167.4",
    "@tanstack/react-router-devtools": "^1.166.9",
    "@tanstack/react-router-ssr-query": "^1.166.9",
    "@tanstack/react-start": "^1.166.15",
    "@tanstack/router-plugin": "^1.166.13",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "conf": "15.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "emojibase-data": "17.0.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "nitro": "latest",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.61.1",
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "9.2.1",
    "dotenv": "^17.4.1",
    "drizzle-kit": "^0.31.10",
    "electron": "43.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wait-on": "9.0.3",
    "web-vitals": "^5.1.0"
  }
}
