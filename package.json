{
  "name": "forge-workspace",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "vite": "8.2.1"
  },
  "scripts": {
    "prepare:local": "bun apps/forge/scripts/ensure-local-agent-secrets.ts",
    "dev": "bun run prepare:local && turbo run dev --filter=@forge/app --filter=@forge/agent-runtime --ui=stream",
    "dev:forge": "bun run prepare:local && turbo run dev --filter=@forge/app --ui=stream",
    "dev:agent": "bun run prepare:local && turbo run dev --filter=@forge/agent-runtime --ui=stream",
    "dev:desktop": "bun run prepare:local && turbo run dev desktop:host --filter=@forge/app --filter=@forge/agent-runtime --ui=stream",
    "build": "turbo run build",
    "preview": "turbo run preview --filter=@forge/app --ui=stream",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"{apps,services}/**/*.{ts,tsx,js,jsx,mjs}\"",
    "desktop:build": "turbo run desktop:build --filter=@forge/app",
    "desktop:start": "turbo run desktop:start --filter=@forge/app",
    "desktop:package": "turbo run desktop:package --filter=@forge/app",
    "desktop:make": "turbo run desktop:make --filter=@forge/app",
    "desktop:release:prepare": "turbo run desktop:release:prepare --filter=@forge/app",
    "desktop:release:upload": "turbo run desktop:release:upload --filter=@forge/app",
    "desktop:release:promote": "turbo run desktop:release:promote --filter=@forge/app",
    "desktop:release:pause": "turbo run desktop:release:pause --filter=@forge/app",
    "desktop:validate": "turbo run desktop:validate --filter=@forge/app",
    "test:desktop": "turbo run test:desktop --filter=@forge/app",
    "email:dev": "turbo run email:dev --filter=@forge/app --ui=stream",
    "db:generate": "turbo run db:generate --filter=@forge/app",
    "db:migrate": "turbo run db:migrate --filter=@forge/app",
    "db:push": "turbo run db:push --filter=@forge/app",
    "db:studio": "turbo run db:studio --filter=@forge/app --ui=stream",
    "agent:retention": "turbo run agent:retention --filter=@forge/app",
    "product:retention": "turbo run product:retention --filter=@forge/app",
    "workflow:health": "turbo run workflow:health --filter=@forge/app",
    "eval:agent": "turbo run eval --filter=@forge/agent-runtime"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.10.8"
  }
}
