    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "identifier",
        "name"
      ]
    },
    "maxResultBytes": 65536
  },
  {
    "id": "artifacts.create",
    "version": "1",
    "summary": "Persist a bounded file generated by this run for the user to download.",
    "risk": "read",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "text",
            "data",
            "report",
            "code"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf8",
            "base64"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "contentType",
        "content"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "runId",
        "name",
        "contentType",
        "sizeBytes",
        "checksum"
      ]
    },
    "maxResultBytes": 32768
  }
]
