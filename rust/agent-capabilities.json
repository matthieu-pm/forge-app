[
  {
    "id": "teams.list",
    "version": "1",
    "summary": "List teams in the actor's current Forge workspace.",
    "risk": "read",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "maxResultBytes": 262144
  },
  {
    "id": "teams.get",
    "version": "1",
    "summary": "Get one team by id or slug in the current Forge workspace.",
    "risk": "read",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "slug": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "maxResultBytes": 65536
  },
  {
    "id": "workspace.describe",
    "version": "1",
    "summary": "Describe the actor's current Forge workspace.",
    "risk": "read",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "actorRole": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "slug",
        "actorRole"
      ]
    },
    "maxResultBytes": 16384
  },
  {
    "id": "teams.update",
    "version": "1",
